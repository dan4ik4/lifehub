# Generate local secrets with python scripts/init_env.py (never prints secrets).
POSTGRES_PASSWORD=
LIFEHUB_ENVIRONMENT=development
LIFEHUB_DATABASE_URL=postgresql+psycopg2://lifehub:YOUR_PASSWORD@localhost:5432/lifehub
LIFEHUB_REDIS_URL=redis://localhost:6379/0
LIFEHUB_JWT_SECRET=
LIFEHUB_OTP_SECRET=
LIFEHUB_ENCRYPTION_KEY=
LIFEHUB_EMAIL_BACKEND=resend
LIFEHUB_RESEND_API_KEY=
LIFEHUB_EMAIL_FROM=Life Hub <noreply@YOUR_VERIFIED_DOMAIN>
LIFEHUB_GOOGLE_CLIENT_IDS=[]
LIFEHUB_APPLE_CLIENT_IDS=[]
LIFEHUB_GOOGLE_CALENDAR_CLIENT_ID=
LIFEHUB_GOOGLE_CALENDAR_CLIENT_SECRET=
LIFEHUB_CALENDAR_REDIRECT_URIS=[]
LIFEHUB_CALENDAR_SYNC_INTERVAL_SECONDS=300
LIFEHUB_OPENAI_API_KEY=
LIFEHUB_OPENAI_MODEL=gpt-5.6-luna
LIFEHUB_CORS_ORIGINS=[]
LIFEHUB_ALLOWED_HOSTS=["localhost","127.0.0.1"]
# Optional authenticated push delivery gateway; see README for delivery contract.
# LIFEHUB_REMINDER_WEBHOOK_URL=https://...
# LIFEHUB_REMINDER_WEBHOOK_TOKEN=...
