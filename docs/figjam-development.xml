    <shape-with-text id="139:764" x="48" y="190" width="460" height="132" name="ROUNDED_RECTANGLE">Экран регистрации
Email + пароль (×2)</shape-with-text>
    <shape-with-text id="139:768" x="48" y="366" width="460" height="132" name="SQUARE">POST /auth/pre-register
Валидация полей → создаётся запись pending_registration</shape-with-text>
    <shape-with-text id="139:772" x="48" y="560" width="460" height="132" name="SQUARE">SendRegisterCode
Код из 6 цифр на email · TTL 10 мин</shape-with-text>
    <shape-with-text id="139:776" x="48" y="736" width="460" height="132" name="ROUNDED_RECTANGLE">Экран подтверждения
Email + код (6 цифр)</shape-with-text>
